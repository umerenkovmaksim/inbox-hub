# Copy to .env and replace placeholders; never commit real credentials.
# All TELEGRAM and SDO credentials are required by the current settings model.

# Telegram application credentials: https://my.telegram.org
TELEGRAM__API_ID=123456
TELEGRAM__API_HASH=api_hash
# Optional, legacy: chats here are tracked on first sync. Prefer `inbox-hub chats add`.
TELEGRAM__SOURCE_IDS=[]
# Choose the history start date before tracking your first chat.
TELEGRAM__BACKFILL_FROM=2026-09-01T00:00:00+03:00
# Stable client identity: set once, never change between runs.
TELEGRAM__DEVICE_MODEL=Inbox Hub
TELEGRAM__SYSTEM_VERSION=Linux
TELEGRAM__APP_VERSION=1.0
TELEGRAM__RECONCILE_INTERVAL_HOURS=4
TELEGRAM__DOWNLOAD_KINDS=["document","photo"]

# University LMS integration; see docs/configuration.md for compatibility.
SDO__URL=https://sdo.timacad.ru
SDO__USERNAME=login
SDO__PASSWORD=password
SDO__EXCLUDE_COURSE_IDS=[]
# html: default; auto: try the mobile REST API, then fall back to HTML.
SDO__BACKEND=html

# Admin token: full access and /admin. Never put it into an MCP config.
# Replace change-me with a random value of at least 24 characters.
# Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API__TOKEN=change-me

# Local storage (Docker sets absolute container paths separately).
DATABASE__URL=sqlite+aiosqlite:///data/inbox.db
DATA_DIR=data
