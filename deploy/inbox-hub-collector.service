[Unit]
Description=Inbox Hub Telegram collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
User=inboxhub
WorkingDirectory=/opt/inbox-hub
EnvironmentFile=/opt/inbox-hub/.env
ExecStart=/opt/inbox-hub/.venv/bin/inbox-hub collect
Restart=always
# Slow restarts: frequent reconnects with the same session look suspicious.
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/inbox-hub/data

[Install]
WantedBy=multi-user.target
